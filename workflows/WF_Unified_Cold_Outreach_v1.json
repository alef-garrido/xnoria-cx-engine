{
    "name": "WF_Unified_Cold_Outreach_v1",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hour",
                            "value": 9
                        }
                    ]
                }
            },
            "id": "1",
            "name": "ScheduleTrigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "mode": "id",
                    "value": "SPREADSHEET_ID"
                },
                "sheetName": {
                    "__rl": true,
                    "mode": "name",
                    "value": "OutreachLeads"
                },
                "filtersUI": {
                    "conditions": [
                        {
                            "keyName": "Status",
                            "condition": "equal",
                            "value": "To- Outreach"
                        }
                    ]
                }
            },
            "id": "2",
            "name": "ReadLeads",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                200,
                0
            ]
        },
        {
            "parameters": {
                "resource": "message",
                "operation": "sendTemplate",
                "phoneNumberId": "={{$env.WHATSAPP_PHONE_NUMBER_ID}}",
                "recipientPhoneNumber": "={{$json.Phone}}",
                "template": "greeting"
            },
            "id": "3",
            "name": "WhatsAppOutbound",
            "type": "n8n-nodes-base.whatsApp",
            "typeVersion": 1,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "amount": 5,
                "unit": "seconds"
            },
            "id": "4",
            "name": "WaitShort",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                600,
                0
            ]
        },
        {
            "parameters": {
                "resource": "message",
                "operation": "send",
                "sendTo": "={{$json.Email}}",
                "subject": "Quick Introduction",
                "emailType": "text",
                "message": "Hello {{$json.Name}},\n\nI just sent you a message on WhatsApp, but wanted to reach out here as well...",
                "appendAttribution": false
            },
            "id": "5",
            "name": "GmailOutbound",
            "type": "n8n-nodes-base.gmail",
            "typeVersion": 2.2,
            "position": [
                800,
                0
            ]
        },
        {
            "parameters": {
                "resource": "contact",
                "operation": "upsert",
                "email": "={{$json.Email}}",
                "additionalFields": {
                    "firstName": "={{$json.Name}}",
                    "phoneNumber": "={{$json.Phone}}",
                    "customPropertiesUi": {
                        "customPropertiesValues": [
                            {
                                "property": "cxengine_source",
                                "value": "cold_outreach"
                            }
                        ]
                    }
                }
            },
            "id": "6",
            "name": "HubSpotSync",
            "type": "n8n-nodes-base.hubspot",
            "typeVersion": 2.2,
            "position": [
                1000,
                0
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "documentId": {
                    "__rl": true,
                    "mode": "id",
                    "value": "SPREADSHEET_ID"
                },
                "sheetName": {
                    "__rl": true,
                    "mode": "name",
                    "value": "OutreachLeads"
                },
                "rowNumber": "={{$json.rowNumber}}",
                "columnsUi": {
                    "column": [
                        {
                            "columnName": "Status",
                            "value": "Outreached"
                        }
                    ]
                }
            },
            "id": "7",
            "name": "UpdateLeadStatus",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                1200,
                0
            ]
        },
        {
            "parameters": {
                "workflowId": "2fDEdMAcGDxxusMp",
                "workflowInputs": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "type": "counter",
                        "name": "cold_outreach_dispatched",
                        "source": "unified_outreach"
                    }
                }
            },
            "id": "8",
            "name": "LogMetrics",
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1.3,
            "position": [
                1400,
                0
            ]
        }
    ],
    "connections": {
        "ScheduleTrigger": {
            "main": [
                [
                    {
                        "node": "ReadLeads",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "ReadLeads": {
            "main": [
                [
                    {
                        "node": "WhatsAppOutbound",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WhatsAppOutbound": {
            "main": [
                [
                    {
                        "node": "WaitShort",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WaitShort": {
            "main": [
                [
                    {
                        "node": "GmailOutbound",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "GmailOutbound": {
            "main": [
                [
                    {
                        "node": "HubSpotSync",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "HubSpotSync": {
            "main": [
                [
                    {
                        "node": "UpdateLeadStatus",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "UpdateLeadStatus": {
            "main": [
                [
                    {
                        "node": "LogMetrics",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "availableInMCP": true
    }
}