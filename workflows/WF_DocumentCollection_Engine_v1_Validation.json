{
    "name": "WF_DocumentCollection_Engine_v1 (Validation)",
    "nodes": [
        {
            "id": "webhook-id",
            "name": "Submission Webhook",
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-doc-submission-v1",
                "responseMode": "onReceived"
            },
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1
        },
        {
            "id": "normalize-id",
            "name": "Normalize Submission",
            "parameters": {
                "jsCode": "const body = $json.body;\nreturn {\n  json: {\n    lead_id: body.lead_id,\n    document_type: body.document_type,\n    media_url: body.media_url || body.file_url,\n    timestamp: new Date().toISOString()\n  }\n};"
            },
            "position": [
                200,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
            "id": "wf07-log-submission-id",
            "name": "WF-07 Log Submission",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "doc_submission_received"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"Normalize Submission\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                400,
                -150
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "validate-id",
            "name": "Validate Document Structure",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "222",
                            "leftValue": "={{ !!$json.media_url }}",
                            "operator": {
                                "operation": "equals",
                                "type": "boolean"
                            },
                            "rightValue": true
                        }
                    ]
                }
            },
            "position": [
                400,
                0
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "wf07-log-success-id",
            "name": "WF-07 Log Success",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "doc_validation_success"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"Normalize Submission\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                650,
                -100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "wf02-compliance-retry-id",
            "name": "WF-02 Compliance (Retry)",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-compliance-validate-v1",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { lead_id: $node[\"Normalize Submission\"].json.lead_id } }}"
            },
            "position": [
                650,
                150
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "allowed-retry-id",
            "name": "Allowed to Message?",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "allowed-id",
                            "leftValue": "={{ $json.allowed }}",
                            "operator": {
                                "operation": "equals",
                                "type": "boolean"
                            },
                            "rightValue": true
                        }
                    ]
                }
            },
            "position": [
                850,
                150
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "failure-id",
            "name": "CRM Update (Failure)",
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "name": "status",
                            "type": "string",
                            "value": "document_rejected"
                        }
                    ]
                }
            },
            "position": [
                1050,
                150
            ],
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4
        }
    ],
    "connections": {
        "Submission Webhook": {
            "main": [
                [
                    {
                        "node": "Normalize Submission",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalize Submission": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Submission",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Validate Document Structure",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Validate Document Structure": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Success",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "WF-02 Compliance (Retry)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-02 Compliance (Retry)": {
            "main": [
                [
                    {
                        "node": "Allowed to Message?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Allowed to Message?": {
            "main": [
                [
                    {
                        "node": "CRM Update (Failure)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}