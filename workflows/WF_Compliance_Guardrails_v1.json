{
  "name": "WF_Compliance_Guardrails_v1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "roya-compliance-validate-v1",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "compliance-webhook-id",
      "name": "Pre-Send Validation Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Logic to check consent registry\n// For MVP, we assume a mock check against lead metadata\nconst lead = $json.body;\nconst hasConsent = lead.metadata && lead.metadata.consent_marketing === true;\n\nreturn {\n  json: {\n    valid: hasConsent,\n    reason: hasConsent ? \"consent_verified\" : \"no_marketing_consent\",\n    lead_id: lead.lead_id\n  }\n};"
      },
      "id": "consent-check-id",
      "name": "1. Consent Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check if lead is in global opt-out list\n// Mock implementation using internal lookup\nconst isOptedOut = false; \n\nreturn {\n  json: {\n    is_blocked: isOptedOut,\n    reason: isOptedOut ? \"lead_opted_out\" : \"not_in_blocklist\"\n  }\n};"
      },
      "id": "optout-check-id",
      "name": "2. Opt-Out Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Frequency limiting logic (max 1/day for marketing)\n// Mock check\nconst currentCount = 0;\nconst limit = 1;\n\nreturn {\n  json: {\n    allowed: currentCount < limit,\n    reason: currentCount >= limit ? \"frequency_limit_exceeded\" : \"within_limits\"\n  }\n};"
      },
      "id": "frequency-check-id",
      "name": "3. Frequency Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Time validation (9 AM - 8 PM local MX)\nconst now = new Date();\nconst hour = now.getUTCHours() - 6; // CT\nconst isAllowedTime = hour >= 9 && hour < 20;\n\nreturn {\n  json: {\n    allowed: isAllowedTime,\n    reason: isAllowedTime ? \"within_allowed_hours\" : \"outside_allowed_hours\",\n    next_allowed_at: isAllowedTime ? null : \"mañana 09:00\"\n  }\n};"
      },
      "id": "time-check-id",
      "name": "4. Time Window Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "allowed",
              "type": "boolean",
              "value": "={{ $('4. Time Window Check').item.json.allowed && $('3. Frequency Check').item.json.allowed && $('2. Opt-Out Check').item.json.is_blocked === false && $('1. Consent Check').item.json.valid }}"
            },
            {
              "name": "reason",
              "type": "string",
              "value": "={{ $json.reason }}"
            },
            {
              "name": "trace_id",
              "type": "string",
              "value": "={{ $('Pre-Send Validation Trigger').item.json.body.lead_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "decision-aggregator-id",
      "name": "Final Aggregator",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1250,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond-id",
      "name": "Return Decision",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "roya-compliance-optout-v1",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "optout-ingest-id",
      "name": "Opt-Out Ingestion Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Logic to process keyword-based opt-out\nconst message = $json.body.message || \"\";\nconst keywords = [\"BAJA\", \"STOP\", \"CANCELAR\"];\nconst isOptOut = keywords.some(k => message.toUpperCase().includes(k));\n\nreturn {\n  json: {\n    detected: isOptOut,\n    lead_id: $json.body.lead_id,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "optout-processor-id",
      "name": "Keyword Optimizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    }
  ],
  "connections": {
    "Pre-Send Validation Trigger": {
      "main": [
        [
          {
            "node": "1. Consent Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Consent Check": {
      "main": [
        [
          {
            "node": "2. Opt-Out Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Opt-Out Check": {
      "main": [
        [
          {
            "node": "3. Frequency Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Frequency Check": {
      "main": [
        [
          {
            "node": "4. Time Window Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Time Window Check": {
      "main": [
        [
          {
            "node": "Final Aggregator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Final Aggregator": {
      "main": [
        [
          {
            "node": "Return Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Opt-Out Ingestion Webhook": {
      "main": [
        [
          {
            "node": "Keyword Optimizer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
