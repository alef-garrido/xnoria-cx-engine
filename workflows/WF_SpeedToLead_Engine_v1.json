{
    "name": "WF_SpeedToLead_Engine_v1",
    "nodes": [
        {
            "id": "webhook-trigger-id",
            "name": "Webhook Trigger",
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-speed-to-lead-v1",
                "responseMode": "onReceived"
            },
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1
        },
        {
            "id": "normalization-id",
            "name": "Normalized Lead",
            "parameters": {
                "jsCode": "// Normalization of fresh lead from webhook\nconst body = $json.body;\nreturn {\n  json: {\n    lead_id: body.id || Math.random().toString(36).substr(2, 9),\n    phone: body.phone,\n    name: body.name,\n    source: \"fresh_optin\",\n    status: \"new\",\n    created_at: new Date().toISOString(),\n    schema_version: \"v1\",\n    metadata: {\n      original_payload: body,\n      niche: body.niche || \"clinica\"\n    }\n  }\n};"
            },
            "position": [
                200,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
            "id": "wf02-compliance-id",
            "name": "WF-02 Compliance Check",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-compliance-validate-v1",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json }}"
            },
            "position": [
                400,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "allowed-filter-id",
            "name": "Is Allowed?",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "allowed-id",
                            "leftValue": "={{ $json.allowed }}",
                            "operator": {
                                "operation": "equals",
                                "type": "boolean"
                            },
                            "rightValue": true
                        }
                    ]
                }
            },
            "position": [
                600,
                0
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "wf07-log-trigger-id",
            "name": "WF-07 Log Trigger",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "speed_to_lead_triggered"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"Normalized Lead\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                800,
                -100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "ack-delivery-id",
            "name": "Immediate Acknowledgment",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "https://graph.facebook.com/v21.0/YOUR_PHONE_NUMBER_ID/messages"
            },
            "position": [
                800,
                100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "wf07-log-acked-id",
            "name": "WF-07 Log Acked",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "speed_to_lead_acked"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"Normalized Lead\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                1000,
                100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        }
    ],
    "connections": {
        "Webhook Trigger": {
            "main": [
                [
                    {
                        "node": "Normalized Lead",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalized Lead": {
            "main": [
                [
                    {
                        "node": "WF-02 Compliance Check",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-02 Compliance Check": {
            "main": [
                [
                    {
                        "node": "Is Allowed?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Allowed?": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Trigger",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Immediate Acknowledgment",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Immediate Acknowledgment": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Acked",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}