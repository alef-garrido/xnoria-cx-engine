{
    "name": "ROYA_Analytics_Metrics_v1",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-metrics-collect-v1",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "metrics-webhook-id",
            "name": "Metrics Emitter Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// Metrics Aggregation Logic\n// Buffers metrics and prepares them for external Export\nconst event = $json.body;\n\n// Anonymize Lead ID (Lead Hash)\nconst crypto = require('crypto');\nconst leadHash = event.lead_id ? crypto.createHash('sha256').update(event.lead_id).digest('hex') : \"anonymous\";\n\nreturn {\n  json: {\n    event_id: \"metrics-\" + Math.random().toString(36).substr(2, 9),\n    event_type: event.type || \"counter\",\n    name: event.name,\n    value: event.value || 1,\n    timestamp: new Date().toISOString(),\n    tags: {\n      android_id: event.android_id,\n      partner_id: event.partner_id,\n      region: event.region,\n      channel: event.channel\n    },\n    lead_hash: leadHash\n  }\n};"
            },
            "id": "aggregator-id",
            "name": "Metrics Aggregator",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                250,
                0
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://metrics.roya.internal/v1/export",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "metric",
                            "value": "={{ $json }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "export-id",
            "name": "Push to Prometheus/Datadog",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                500,
                0
            ]
        }
    ],
    "connections": {
        "Metrics Emitter Webhook": {
            "main": [
                [
                    {
                        "node": "Metrics Aggregator",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Metrics Aggregator": {
            "main": [
                [
                    {
                        "node": "Push to Prometheus/Datadog",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}