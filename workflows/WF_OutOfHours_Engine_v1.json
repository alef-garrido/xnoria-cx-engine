{
    "name": "ROYA_WF_OutOfHours_Engine_v1",
    "nodes": [
        {
            "id": "webhook-id",
            "name": "Inbound Trigger",
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-ooh-trigger-v1",
                "responseMode": "onReceived"
            },
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1
        },
        {
            "id": "wf02-compliance-id",
            "name": "WF-02 Compliance Check",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-compliance-validate-v1",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json.body }}"
            },
            "position": [
                200,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "ooh-filter-id",
            "name": "Is Out of Hours?",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "ooh-id",
                            "leftValue": "={{ $json.reason }}",
                            "operator": {
                                "operation": "equals",
                                "type": "string"
                            },
                            "rightValue": "outside_allowed_hours"
                        }
                    ]
                }
            },
            "position": [
                400,
                0
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "wf07-log-ooh-id",
            "name": "WF-07 Log OOH",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "ooh_nurture_triggered"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"WF-02 Compliance Check\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                600,
                -150
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "ai-nurture-id",
            "name": "AI Nurture Bot (Groq)",
            "parameters": {
                "promptType": "define",
                "text": "Hola, gracias por escribirnos fuera de horario. ¿En qué podemos ayudarte? Mientras tanto, cuéntanos tu nombre."
            },
            "position": [
                600,
                -30
            ],
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 3.1
        },
        {
            "id": "handoff-id",
            "name": "Direct Sales Handoff",
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "name": "status",
                            "type": "string",
                            "value": "new_lead_business_hours"
                        }
                    ]
                }
            },
            "position": [
                600,
                150
            ],
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4
        }
    ],
    "connections": {
        "Inbound Trigger": {
            "main": [
                [
                    {
                        "node": "WF-02 Compliance Check",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-02 Compliance Check": {
            "main": [
                [
                    {
                        "node": "Is Out of Hours?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Out of Hours?": {
            "main": [
                [
                    {
                        "node": "WF-07 Log OOH",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "AI Nurture Bot (Groq)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Direct Sales Handoff",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}