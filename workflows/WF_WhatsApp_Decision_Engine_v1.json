{
    "name": "WF_WhatsApp_Decision_Engine_v1",
    "nodes": [
        {
            "id": "wa-webhook-id",
            "name": "WhatsApp Webhook Inbound",
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-whatsapp-inbound-v1",
                "responseMode": "onReceived"
            },
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1
        },
        {
            "id": "adapter-id",
            "name": "Normalizer (WhatsApp Adapter)",
            "parameters": {
                "jsCode": "// Normalization logic from FR-2\nconst raw = $json.body;\nlet normalized_message = \"\";\nconst type = raw.message_type || \"text\";\n\nswitch(type) {\n  case \"text\": normalized_message = raw.message; break;\n  case \"image\": normalized_message = \"IMAGEN: \" + (raw.metadata.caption || \"SIN_CONTEXTO\"); break;\n  case \"audio\": normalized_message = \"AUDIO_TRANSCRITO: [Simulated Transcription]\"; break;\n  case \"location\": normalized_message = `UBICACION: ${raw.metadata.lat}, ${raw.metadata.long}`; break;\n  default: normalized_message = \"UNKNOWN_FORMAT\";\n}\n\nreturn {\n  json: {\n    input_id: raw.input_id,\n    channel: \"whatsapp\",\n    message: normalized_message,\n    metadata: raw.metadata\n  }\n};"
            },
            "position": [
                240,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
            "id": "wf07-log-inbound-id",
            "name": "WF-07 Log Inbound",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "wa_inbound_received"
                        },
                        {
                            "name": "channel",
                            "value": "whatsapp"
                        }
                    ]
                }
            },
            "position": [
                480,
                -150
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "wf02-compliance-id",
            "name": "WF-02 Compliance Check",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-compliance-validate-v1",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { lead_id: $node[\"Normalizer (WhatsApp Adapter)\"].json.input_id || $node[\"Normalizer (WhatsApp Adapter)\"].json.metadata.from } }}"
            },
            "position": [
                720,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "decision-id",
            "name": "Core Decision Engine",
            "parameters": {
                "promptType": "define",
                "text": "Analyze this WhatsApp message and decide the next action based on ROYA contracts. Message: {{ $node[\"Normalizer (WhatsApp Adapter)\"].json.message }}"
            },
            "position": [
                960,
                0
            ],
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 3.1
        },
        {
            "id": "wf07-log-decision-id",
            "name": "WF-07 Log Decision",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "wa_decision_made"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"Normalizer (WhatsApp Adapter)\"].json.input_id }}"
                        }
                    ]
                }
            },
            "position": [
                1200,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        }
    ],
    "connections": {
        "WhatsApp Webhook Inbound": {
            "main": [
                [
                    {
                        "node": "Normalizer (WhatsApp Adapter)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalizer (WhatsApp Adapter)": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Inbound",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "WF-02 Compliance Check",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-02 Compliance Check": {
            "main": [
                [
                    {
                        "node": "Core Decision Engine",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Core Decision Engine": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Decision",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}