{
    "name": "WF_SleepingBeauty_DBR_Engine_v1 (Ingestion)",
    "nodes": [
        {
            "id": "manual-trigger-id",
            "name": "Manual Trigger",
            "parameters": {},
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1
        },
        {
            "id": "ingestion-id",
            "name": "Ingestion",
            "parameters": {
                "jsCode": "// Simulated CSV Ingestion Logic\nconst leads = [\n  { phone: \"+521234567890\", name: \"Juan Perez\", source: \"old_db_2024\" },\n  { phone: \"+520987654321\", name: \"Maria Garcia\", source: \"old_db_2024\" }\n];\n\nreturn leads.map(l => ({ json: l }));"
            },
            "position": [
                200,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
            "id": "wf01-lead-factory-id",
            "name": "WF-01 Lead Factory",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-shared-lead-factory-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "phone",
                            "value": "={{ $json.phone }}"
                        },
                        {
                            "name": "source",
                            "value": "db_reactivation"
                        },
                        {
                            "name": "metadata",
                            "value": "={{ { name: $json.name, original_source: $json.source } }}"
                        }
                    ]
                }
            },
            "position": [
                400,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "wf02-compliance-id",
            "name": "WF-02 Compliance Check",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-compliance-validate-v1",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json }}"
            },
            "position": [
                600,
                0
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "compliance-filter-id",
            "name": "Is Allowed?",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "allowed-id",
                            "leftValue": "={{ $json.allowed }}",
                            "operator": {
                                "operation": "equals",
                                "type": "boolean"
                            },
                            "rightValue": true
                        }
                    ]
                }
            },
            "position": [
                800,
                0
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "wf07-log-trigger-id",
            "name": "WF-07 Log Trigger",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "dbr_ingestion_triggered"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"WF-01 Lead Factory\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                1000,
                -100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "ack-delivery-id",
            "name": "WhatsApp Sandbox (Kiss Delivery)",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "https://graph.facebook.com/v21.0/YOUR_PHONE_NUMBER_ID/messages",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $node[\"WF-01 Lead Factory\"].json }}"
            },
            "position": [
                1000,
                100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        },
        {
            "id": "wf07-log-sent-id",
            "name": "WF-07 Log Sent",
            "parameters": {
                "httpMethod": "POST",
                "options": {},
                "url": "http://localhost:5678/webhook/roya-metrics-collect-v1",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "type",
                            "value": "counter"
                        },
                        {
                            "name": "name",
                            "value": "dbr_message_sent"
                        },
                        {
                            "name": "lead_id",
                            "value": "={{ $node[\"WF-01 Lead Factory\"].json.lead_id }}"
                        }
                    ]
                }
            },
            "position": [
                1200,
                100
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4
        }
    ],
    "connections": {
        "Manual Trigger": {
            "main": [
                [
                    {
                        "node": "Ingestion",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Ingestion": {
            "main": [
                [
                    {
                        "node": "WF-01 Lead Factory",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-01 Lead Factory": {
            "main": [
                [
                    {
                        "node": "WF-02 Compliance Check",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WF-02 Compliance Check": {
            "main": [
                [
                    {
                        "node": "Is Allowed?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Allowed?": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Trigger",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "WhatsApp Sandbox (Kiss Delivery)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "WhatsApp Sandbox (Kiss Delivery)": {
            "main": [
                [
                    {
                        "node": "WF-07 Log Sent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}