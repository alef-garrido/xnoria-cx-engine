                "jsCode": "// Simulated CSV Ingestion Logic\n// In production, this would follow a 'Read Binary File' or 'Google Sheets' node\nconst leads = [\n  { phone: \"+521234567890\", name: \"Juan Perez\", source: \"old_db_2024\" },\n  { phone: \"+520987654321\", name: \"Maria Garcia\", source: \"old_db_2024\" }\n];\n\nreturn leads.map(l => ({\n  json: {\n    lead_id: Math.random().toString(36).substr(2, 9),\n    phone: l.phone,\n    name: l.name,\n    source: \"db_reactivation\",\n    status: \"new\",\n    created_at: new Date().toISOString(),\n    schema_version: \"v1\",\n    metadata: {\n      original_source: l.source,\n      niche: \"clinica\"\n    }\n  }\n}));"
            },
            "position": [
                200,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
            "id": "compliance-check-id",
            "name": "Compliance Check",
            "parameters": {
                "jsCode": "// Compliance Guardrails Implementation (Simplified)\nconst lead = $json;\nconst isOptedOut = false; // This would query a Global Opt-Out list in production\n\nif (isOptedOut) {\n  return {\n    json: { ...lead, compliance_result: \"blocked\", reason: \"opt_out\" }\n  };\n}\n\nreturn {\n  json: { ...lead, compliance_result: \"allowed\" }\n};"
            },
            "position": [
                400,
                0
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
        },
        {
