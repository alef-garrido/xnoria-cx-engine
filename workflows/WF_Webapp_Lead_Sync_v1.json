      "parameters": {
        "jsCode": "const input = $json.lead;\nconst errors = [];\nif (!input.email && !input.phone) errors.push('Missing email or phone');\nif (errors.length > 0) throw new Error('Invalid Lead: ' + errors.join(', '));\n\nreturn [{\n  json: {\n    lead_id: input.lead_id || `webapp-${Date.now()}`,\n    name: input.name || '',\n    email: input.email,\n    phone: input.phone || '',\n    source: input.source || 'webapp_landing',\n    status: 'new',\n    consent_verified: input.consent_verified !== false,\n    created_at: new Date().toISOString(),\n    schema_version: 'v1',\n    metadata: input.metadata || {}\n  }\n}];"
      },
