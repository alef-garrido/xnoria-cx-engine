{
    "name": "WF_DocumentCollection_Engine_v1 (Triggers)",
    "nodes": [
        {
            "id": "crm-webhook-id",
            "name": "Shared CRM Trigger",
            "parameters": {
                "httpMethod": "POST",
                "path": "roya-crm-webhook-v1",
                "responseMode": "onReceived"
            },
            "position": [
                0,
                0
            ],
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1
        },
        {
            "id": "status-check-id",
            "name": "Lead Awaiting Documents",
            "parameters": {
                "conditions": {
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "111",
                            "leftValue": "={{ $json.body.status }}",
                            "operator": {
                                "operation": "equals",
                                "type": "string"
                            },
                            "rightValue": "awaiting_documents"
                        }
                    ],
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict",
                        "version": 2
                    }
                }
            },
            "position": [
                240,
                0
            ],
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2
        },
        {
            "id": "router-id",
            "name": "Channel Router",
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "combinator": "and",
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.body.preferred_channel }}",
                                        "operator": {
                                            "operation": "equals",
                                            "type": "string"
                                        },
                                        "rightValue": "whatsapp"
                                    }
                                ]
                            }
                        },
                        {
                            "conditions": {
                                "combinator": "and",
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.body.preferred_channel }}",
                                        "operator": {
                                            "operation": "equals",
                                            "type": "string"
                                        },
                                        "rightValue": "email"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            "position": [
                480,
                0
            ],
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3.4
        }
    ],
    "connections": {
        "Shared CRM Trigger": {
            "main": [
                [
                    {
                        "node": "Lead Awaiting Documents",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Lead Awaiting Documents": {
            "main": [
                [
                    {
                        "node": "Channel Router",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}