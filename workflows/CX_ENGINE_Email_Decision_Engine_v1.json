      "parameters": {
        "jsCode": "const input = $json.body || $json; \nconst snippet = input.snippet || input.textPlain || input.message || \"\";\nreturn {\n  json: {\n    input_id: \"id-\" + (input.id || input.messageId || Math.random().toString(36).substr(2, 9)),\n    channel: input.channel || \"email\",\n    message: snippet,\n    context_domain: \"clinic\",\n    metadata: {\n      from: input.From || input.from || \"unknown\",\n      subject: input.Subject || input.subject || \"Sin asunto\",\n      timestamp: new Date().toISOString()\n    }\n  }\n};"
      },
