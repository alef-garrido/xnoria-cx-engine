  "name": "cxEngine_WF_Compliance_Guardrails_v1",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cxEngine-compliance-validate-v1",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "PreSendTrigger",
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "webhookId": "4544cef9-5db4-4229-bf05-bf179d8c5df8",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $json.body ? $json.body : $json;\nconst hasConsent = (lead.metadata && lead.metadata.consent_marketing === true) || \n                   (lead.metadata && lead.metadata.original_payload && lead.metadata.original_payload.consent_flag === true) || \n                   (lead.consent_flag === true) || lead.consent_verified === true;\n\nreturn {\n  json: {\n    valid: hasConsent,\n    reason: hasConsent ? \"consent_verified\" : \"no_marketing_consent\",\n    lead_id: lead.lead_id,\n    allowed: hasConsent\n  }\n};"
      },
      "id": "2",
      "name": "ConsentCheck",
      "position": [
        208,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const isOptedOut = false; \nreturn {\n  json: {\n    is_blocked: isOptedOut,\n    reason: isOptedOut ? \"lead_opted_out\" : \"not_in_blocklist\"\n  }\n};"
      },
      "id": "3",
      "name": "OptOutCheck",
      "position": [
        400,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const currentCount = 0;\nconst limit = 1;\nreturn {\n  json: {\n    allowed: currentCount < limit,\n    reason: currentCount >= limit ? \"frequency_limit_exceeded\" : \"within_limits\"\n  }\n};"
      },
      "id": "4",
      "name": "FrequencyCheck",
      "position": [
        608,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst hour = now.getUTCHours() - 6; \nconst isAllowedTime = hour >= 9 && hour < 20;\nreturn {\n  json: {\n    allowed: isAllowedTime,\n    reason: isAllowedTime ? \"within_allowed_hours\" : \"outside_allowed_hours\"\n  }\n};"
      },
      "id": "5",
      "name": "TimeWindowCheck",
      "position": [
        800,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "allowed",
              "type": "boolean",
              "value": "={{ $('TimeWindowCheck').item.json.allowed && $('FrequencyCheck').item.json.allowed && $('OptOutCheck').item.json.is_blocked === false && $('ConsentCheck').item.json.valid }}"
            },
            {
              "name": "trace_id",
              "type": "string",
              "value": "={{ $('ConsentCheck').item.json.lead_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "6",
      "name": "FinalAggregator",
      "position": [
        1008,
        0
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7",
      "name": "ReturnDecision",
      "position": [
        1200,
        0
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cxEngine-compliance-optout-v1",
        "options": {}
      },
      "id": "8",
      "name": "OptOutTrigger",
      "position": [
        0,
        208
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "webhookId": "4f67489e-15a3-4c28-920f-3469a8b816ea"
    },
    {
      "parameters": {
        "jsCode": "const message = $json.body.message || \"\";\nconst keywords = [\"BAJA\", \"STOP\", \"CANCELAR\"];\nconst isOptOut = keywords.some(k => message.toUpperCase().includes(k));\nreturn {\n  json: { detected: isOptOut, lead_id: $json.body.lead_id }\n};"
      },
      "id": "9",
      "name": "KeywordProcessor",
      "position": [
        208,
        208
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {},
      "id": "execute-trigger",
      "name": "ExecuteWorkflowTrigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -208
      ]
    }
  ],
