{
    "name": "WF_Email_Intake_Dispatch_v1_MINIMAL",
    "nodes": [
        {
            "id": "1",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                200,
                300
            ],
            "parameters": {
                "path": "email-intake-decision",
                "method": "POST"
            }
        },
        {
            "id": "2",
            "name": "Set_Action",
            "type": "n8n-nodes-base.set",
            "typeVersion": 2,
            "position": [
                450,
                300
            ],
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "primary_action",
                            "value": "={{$json.decision.primary_action}}"
                        }
                    ]
                }
            }
        },
        {
            "id": "3",
            "name": "IF_Escalate",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                700,
                300
            ],
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{$json.primary_action}}",
                            "operation": "equal",
                            "value2": "ESCALATE_HUMAN"
                        }
                    ]
                }
            }
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Set_Action",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Set_Action": {
            "main": [
                [
                    {
                        "node": "IF_Escalate",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false
}